# Copy this file to .env and adjust values for your environment.
# .env is git-ignored — never commit real credentials.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger

# ── Redis ──────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ── Redpanda (Kafka) ───────────────────────────────────────
REDPANDA_BROKERS=localhost:19092

# ── Apicurio Schema Registry ───────────────────────────────
APICURIO_URL=http://localhost:8082

# ── MinIO ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# ── pgAdmin 4 ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@ledger.dev
PGADMIN_PASSWORD=admin

# ── Debezium ───────────────────────────────────────────────
DEBEZIUM_URL=http://localhost:8083

# ── Toxiproxy (chaos tests only) ───────────────────────────
TOXIPROXY_API=http://localhost:8474
TOXIPROXY_POSTGRES=localhost:15432
TOXIPROXY_REDIS=localhost:16379
TOXIPROXY_REDPANDA=localhost:19093

# ── Observability (Part 3) ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ADDR=:9090
