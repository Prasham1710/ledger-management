# Binaries
bin/
dist/
*.exe

# Go workspace sum (committed per-module go.sum files are enough)
go.work.sum

# Build artefacts
*.test
*.out
coverage.html
coverage.txt

# Environment files — never commit secrets
.env
.env.local
.env.*.local
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Generated protobuf / oapi output (regenerated by make generate)
gen/

# MinIO data (local dev volume)
data/minio/

# Postgres data (local dev volume)
data/postgres/

# Grafana provisioning state
data/grafana/

# Claude Code — local personal settings (contains machine-specific allowed commands)
.claude/settings.local.json

# Node — never commit dependencies or build output
node_modules/
ui/dist/

# Service log files
*.log
